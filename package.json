{
	"name": "cloudstats-app",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "concurrently \"npm run start\" \"npm run dev:css\"",
		"dev:css": "npx @tailwindcss/cli -i ./src/index.css -o ./public/index.css --watch",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:apply:local": "wrangler d1 migrations apply cloudstats",
		"db:apply:remote": "wrangler d1 migrations apply cloudstats --remote"
	},
	"devDependencies": {
		"@types/node": "25.3.3",
		"concurrently": "9.2.1",
		"drizzle-kit": "0.31.9",
		"typescript": "5.9.3",
		"wrangler": "4.69.0"
	},
	"dependencies": {
		"@tailwindcss/cli": "4.2.4",
		"drizzle-orm": "0.45.1",
		"hono": "4.12.3",
		"tailwindcss": "4.2.4"
	}
}
